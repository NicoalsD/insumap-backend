# Copia este archivo a .env y ajusta los valores. .env no se versiona.

# Entorno de ejecución: local, test o production.
APP_ENV=local

# Nivel de logs: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# Cadena de conexión a PostgreSQL. Con Docker Compose, la API usa el host db.
DATABASE_URL=postgresql://insumap:cambia-esto-password-local@localhost:5432/insumap

# Orígenes permitidos por CORS, separados por comas (frontend local con Vite).
CORS_ORIGINS=http://localhost:5173

# Habilita Swagger (/docs) y ReDoc. Desactívalo en producción.
API_DOCS_ENABLED=true

# Variables de Docker Compose para el contenedor de PostgreSQL.
# Deben coincidir con las credenciales de DATABASE_URL.
POSTGRES_USER=insumap
POSTGRES_PASSWORD=cambia-esto-password-local
POSTGRES_DB=insumap
