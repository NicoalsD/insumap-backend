# Copia este archivo a .env y ajusta los valores. .env no se versiona.

# Entorno de ejecución: local, test o production.
APP_ENV=local

# Nivel de logs: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# Cadena de conexión a PostgreSQL. Con Docker Compose, la API usa el host db.
DATABASE_URL=postgresql://insumap:cambia-esto-password-local@localhost:5432/insumap

# Orígenes permitidos por CORS, separados por comas (frontend local con Vite).
CORS_ORIGINS=http://localhost:5173

# Valores de Host que acepta la API, separados por comas (*.dominio admite
# subdominios). Un Host ajeno recibe 400. En local y test, si falta, vale
# localhost,127.0.0.1,testserver; en production es obligatoria.
ALLOWED_HOSTS=localhost,127.0.0.1

# Habilita Swagger (/docs) y ReDoc. Desactívalo en producción.
API_DOCS_ENABLED=true

# Llaves de 32 bytes en base64. Sin valor por defecto: si faltan o no son válidas,
# la API no arranca. El marcador "cambia-esto" no es válido a propósito.
# Genera cada una con: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Firma de los access tokens (JWT HS256).
JWT_SECRET=cambia-esto-jwt-secret
# Cifrado AES-256-GCM del secreto TOTP.
MFA_ENCRYPTION_KEY=cambia-esto-clave-cifrado-mfa
# HMAC de los códigos de activación y de respaldo.
CODE_HMAC_KEY=cambia-esto-clave-hmac-codigos
# HMAC de los contadores (bloqueos de login y límites de tasa), por subllave.
APP_HMAC_KEY=cambia-esto-clave-hmac-aplicacion
# Para rotar una llave, pasa la actual a *_PREVIOUS (solo verifica o descifra) y
# pon la nueva en la variable principal. Déjalas vacías si no hay rotación.
# JWT_SECRET_PREVIOUS=
# MFA_ENCRYPTION_KEY_PREVIOUS=
# CODE_HMAC_KEY_PREVIOUS=

# Sesión (valores de docs/Seguridad.md). Los de abajo son los de por defecto.
JWT_ISSUER=insumap-api
JWT_AUDIENCE=insumap-web
JWT_ACCESS_MINUTES=15
JWT_LEEWAY_SECONDS=30
REFRESH_TOKEN_DAYS=30
REFRESH_FAMILY_MAX_DAYS=90
REFRESH_TOKEN_STAFF_HOURS=12

# Argon2id (mínimo de OWASP) e historial de contraseñas.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_HASH_MAX_CONCURRENCY=4
PASSWORD_HISTORY_SIZE=5

# Activación, segundo factor y límites de tasa de identidad.
ACTIVATION_MAX_ATTEMPTS=5
ACTIVATION_SESSION_TTL_MINUTES=15
MFA_TOTP_VALID_WINDOW=1
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5
MFA_RECOVERY_CODE_COUNT=10
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=20
RATE_LIMIT_MFA_PER_IP_PER_MINUTE=20
RATE_LIMIT_ACTIVATION_PER_IP_PER_MINUTE=10
RATE_LIMIT_ACTIVATION_PER_IP_PER_HOUR=50
RATE_LIMIT_REFRESH_PER_USER_PER_MINUTE=30

# Variables de Docker Compose para el contenedor de PostgreSQL.
# Deben coincidir con las credenciales de DATABASE_URL.
POSTGRES_USER=insumap
POSTGRES_PASSWORD=cambia-esto-password-local
POSTGRES_DB=insumap

# Restablecimiento de contraseña, verificación de correo e invitaciones del personal.
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
STAFF_INVITATION_DAYS=7
RATE_LIMIT_RESET_REQUEST_PER_IP_PER_HOUR=5
RATE_LIMIT_RESET_REQUEST_PER_ACCOUNT_PER_HOUR=3
RATE_LIMIT_RESET_COMPLETE_PER_IP_PER_MINUTE=10
# Base de los enlaces que se envían por correo (el token va en el fragmento #token=).
WEB_APP_BASE_URL=http://localhost:5173
# Hosts de servicios Web Push aceptados como endpoint de suscripción, separados por comas.
# "*." acepta cualquier subdominio. Lista propuesta; verificar antes de producción.
PUSH_ENDPOINT_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,*.notify.windows.com
# Credenciales de pacientes: vigencia del código (168 h = 7 días) y límites por clínica (API.md 5).
ACTIVATION_CODE_TTL_HOURS=168
RATE_LIMIT_CREDENTIAL_ISSUE_PER_CLINIC_PER_HOUR=300
RATE_LIMIT_CREDENTIAL_BATCH_PER_CLINIC_PER_HOUR=10
# Reportes: conteos menores a este número no se muestran en los indicadores de la clínica (API.md 8.11).
REPORT_SMALL_COUNT_THRESHOLD=5
# Servicio de IA (docs/Contrato-IA.md, 10.1). Sin AI_SERVICE_URL, el pronóstico responde con el respaldo por reglas.
# AI_SERVICE_TOKEN es un secreto de al menos 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_ENABLED=true
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
AI_TIMEOUT_CONNECT_SECONDS=2
AI_TIMEOUT_FORECAST_SECONDS=3
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_SECONDS=30
AI_TIMEOUT_RISK_SECONDS=3
AI_TIMEOUT_SUMMARY_SECONDS=30
AI_TIMEOUT_ASSISTANT_SECONDS=20
# Sin esta variable, un resumen de una clínica no demo usa la plantilla determinista (Modulo-IA 6.5).
LLM_REAL_DATA_ALLOWED=false
RATE_LIMIT_ASSISTANT_PER_PATIENT_PER_HOUR=20
RATE_LIMIT_ASSISTANT_PER_PATIENT_PER_DAY=100
RATE_LIMIT_SUMMARY_PER_DOCTOR_PER_HOUR=30

# Dias para responder una solicitud de privacidad (provisional: el plazo legal esta pendiente de verificar)
PRIVACY_REQUEST_DUE_DAYS=10
