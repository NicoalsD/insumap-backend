<mxfile host="drawio" type="device"><diagram name="componentes-backend" id="componentes-backend"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="insumap-backend: componentes (arquitectura hexagonal)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=18;align=left;verticalAlign=middle;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1820" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Arranque&lt;/b&gt;: &lt;font face=&quot;monospace&quot;&gt;main.py&lt;/font&gt; (create_app: middleware, routers, manejador de errores) · &lt;font face=&quot;monospace&quot;&gt;container.py&lt;/font&gt; (composition root, único lugar donde se arman las dependencias) · &lt;font face=&quot;monospace&quot;&gt;scheduler.py&lt;/font&gt; (mismo contenedor, solo registra los trabajos)" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="220" y="70" width="1400" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Clientes&lt;/b&gt;&lt;br&gt;PWA y simulador" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="150" height="100" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:14px&quot;&gt;insumap.api&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;*Router&lt;/font&gt; (APIRouter con casos de uso inyectados)&lt;br&gt;Modelos &lt;font face=&#x27;monospace&#x27;&gt;*Request&lt;/font&gt; y &lt;font face=&#x27;monospace&#x27;&gt;*Response&lt;/font&gt; (Pydantic v2, extra=forbid)&lt;br&gt;Mappers &lt;font face=&#x27;monospace&#x27;&gt;*Request → *Input&lt;/font&gt; y &lt;font face=&#x27;monospace&#x27;&gt;*Result → *Response&lt;/font&gt;&lt;br&gt;Middleware: &lt;font face=&#x27;monospace&#x27;&gt;RequestIdMiddleware&lt;/font&gt;, &lt;font face=&#x27;monospace&#x27;&gt;BodySizeLimitMiddleware&lt;/font&gt;, &lt;font face=&#x27;monospace&#x27;&gt;SecurityHeadersMiddleware&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;CurrentActor&lt;/font&gt; (Depends)&lt;br&gt;Manejador de errores canónico y tabla &lt;font face=&#x27;monospace&#x27;&gt;ErrorCode → HTTP&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="180" width="330" height="280" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:14px&quot;&gt;insumap.application&lt;/b&gt;&lt;br&gt;&lt;br&gt;Casos de uso &lt;font face=&#x27;monospace&#x27;&gt;*UseCase.execute(*Input)&lt;/font&gt; → &lt;font face=&#x27;monospace&#x27;&gt;*Result&lt;/font&gt;&lt;br&gt;Puertos &lt;font face=&#x27;monospace&#x27;&gt;*Port&lt;/font&gt; (abc.ABC) y &lt;font face=&#x27;monospace&#x27;&gt;UnitOfWork&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;CommandBus&lt;/font&gt;, comandos y handlers (P13), &lt;font face=&#x27;monospace&#x27;&gt;AuditingCommandHandler&lt;/font&gt; (P09)&lt;br&gt;Fachadas (P10)&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;Notification&lt;/font&gt; (P07)&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;PatientImportPipeline&lt;/font&gt; (P20)&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;DomainEventPublisher&lt;/font&gt; y suscriptores&lt;br&gt;Trabajos programados &lt;font face=&#x27;monospace&#x27;&gt;*Job&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#2E8B57;fillColor=#DFF0E3;fontColor=#222222;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="720" y="180" width="440" height="280" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:14px&quot;&gt;insumap.domain&lt;/b&gt;&lt;br&gt;&lt;br&gt;Entidades y value objects (dataclasses congeladas)&lt;br&gt;Estados (P18), reglas &lt;font face=&#x27;monospace&#x27;&gt;AlertRule&lt;/font&gt; (P08, P12, P19, P22)&lt;br&gt;Prototipos (P05), builders (P04), mementos (P16), visitantes (P21), iteradores (P14)&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;PatientAccessPolicy&lt;/font&gt;&lt;br&gt;Eventos de dominio y errores &lt;font face=&#x27;monospace&#x27;&gt;*Error&lt;/font&gt;&lt;br&gt;&lt;i&gt;Python puro: sin frameworks, red ni reloj&lt;/i&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C8741F;fillColor=#FCEBD5;fontColor=#222222;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1280" y="180" width="320" height="280" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:14px&quot;&gt;insumap.shared&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;Clock&lt;/font&gt;, &lt;font face=&#x27;monospace&#x27;&gt;SystemClock&lt;/font&gt; (P01)&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;ErrorCode&lt;/font&gt;, &lt;font face=&#x27;monospace&#x27;&gt;DomainError&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;FieldLimits&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;monospace&#x27;&gt;Settings&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Lo usan todas las capas; no importa a nadie&lt;/i&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSiz