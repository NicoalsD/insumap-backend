<mxfile host="drawio" type="device"><diagram name="secuencia-activacion" id="secuencia-activacion"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1530" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Secuencia: activación de la cuenta del paciente" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=18;align=left;verticalAlign=middle;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1460" height="30" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="130" as="sourcePoint"/><mxPoint x="1345" y="1490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="130" as="sourcePoint"/><mxPoint x="1045" y="1490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="130" as="sourcePoint"/><mxPoint x="745" y="1490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="130" as="sourcePoint"/><mxPoint x="445" y="1490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="130" as="sourcePoint"/><mxPoint x="145" y="1490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;Paciente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PWA, sin sesión&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="210" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;endpoints públicos de activación&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="210" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Caso de uso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;activación&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#2E8B57;fillColor=#DFF0E3;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="210" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;iam, clinic y audit&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#6C4FA1;fillColor=#E8E0F4;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="210" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Publicador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;InProcessDomainEventPublisher P17&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#7A7A7A;fillColor=#FFFFFF;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1240" y="60" width="210" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;1. Verificación del código&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="154" width="1360" height="26" as="geometry"/></mxCell><mxCell id="c9" value="1. &lt;font face=&quot;monospace&quot;&gt;POST /api/v1/auth/activation/verify&lt;/font&gt; con &lt;font face=&quot;monospace&quot;&gt;activation_code&lt;/font&gt; y &lt;font face=&quot;monospace&quot;&gt;birth_date&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="153" y="198" width="284" height="34" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="238" as="sourcePoint"/><mxPoint x="445" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="2. Normaliza el código. Si no cumple el formato: &lt;font face=&quot;monospace&quot;&gt;410 INVITATION_INVALID&lt;/font&gt; (cuenta para la tasa por IP)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="453" y="256" width="284" height="49" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="311" as="sourcePoint"/><mxPoint x="745" y="311" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="3. &lt;font face=&quot;monospace&quot;&gt;iam.lookup_invitation_by_code_hash&lt;/font&gt; (&lt;font face=&quot;monospace&quot;&gt;SECURITY DEFINER&lt;/font&gt;, columnas mínimas, antes de conocer la clínica)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="753" y="329" width="284" height="49" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="384" as="sourcePoint"/><mxPoint x="1045" y="384" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="No existe, no está &lt;font face=&quot;monospace&quot;&gt;PENDING&lt;/font&gt; o venció: &lt;font face=&quot;monospace&quot;&gt;410 INVITATION_INVALID&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="375" y="402" width="740" height="29" as="geometry"/></mxCell><mxCell id="c16" value="4. Fija &lt;font face=&quot;monospace&quot;&gt;app.clinic_id&lt;/font&gt; de la invitación y compara la fecha de nacimiento con la del paciente" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="753" y="449" width="284" height="34" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="489" as="sourcePoint"/><mxPoint x="1045" y="489" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="Si no coincide: &lt;font face=&quot;monospace&quot;&gt;failed_attempts + 1&lt;/font&gt;. Al llegar a 5 la invitación pasa a &lt;font face=&quot;monospace&quot;&gt;LOCKED&lt;/font&gt; (evento &lt;font face=&quot;monospace&quot;&gt;ACTIVATION_LOCKED&lt;/font&gt;). Siempre responde &lt;font face=&quot;monospace&quot;&gt;410 INVITATION_INVALID&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="375" y="507" width="740" height="44" as="geometry"/></mxCell><mxCell id="c19" value="5. Si coincide: la invitación pasa de &lt;font face=&quot;monospace&quot;&gt;PENDING&lt;/font&gt; a &lt;font face=&quot;monospace&quot;&gt;VERIFIED&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="753" y="569" width="284" height="34" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="609" as="sourcePoint"/><mxPoint x="1045" y="609" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="6. &lt;font face=&quot;monospace&quot;&gt;activation_token&lt;/font&gt; de 15 min, nombre de la clínica y versión vigente del aviso de privacidad" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="453" y="627" width="284" height="49" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="682" as="sourcePoint"/><mxPoint x="445" y="682" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="7. &lt;font face=&quot;monospace&quot;&gt;200&lt;/font&gt; sin el nombre del paciente ni otros datos personales" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="153" y="700" width="284" height="34" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="740" as="sourcePoint"/><mxPoint x="145" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;2. Lectura del aviso de privacidad&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="758" width="1360" height="26" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="802" as="sourcePoint"/><mxPoint x="145" y="826" as="targetPoint"/><Array as="points"><mxPoint x="179" y="802"/><mxPoint x="179" y="826"/></Array></mxGeometry></mxCell><mxCell id="c27" value="8. La PWA muestra el aviso de privacidad vigente de la clínica" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="185" y="797" width="300" height="34" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;3. Finalización&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="858" width="1360" height="26" as="geometry"/></mxCell><mxCell id="c29" value="9. &lt;font face=&quot;monospace&quot;&gt;POST /api/v1/auth/activation/complete&lt;/font&gt; con &lt;font face=&quot;monospace&quot;&gt;activation_token&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;new_password&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;email&lt;/font&gt; si falta y &lt;font face=&quot;monospace&quot;&gt;consent&lt;/font&gt; (&lt;font face=&quot;monospace&quot;&gt;privacy_notice_version_id&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;accepted: true&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;ai_external_processing&lt;/font&gt;)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="153" y="902" width="284" height="64" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="972" as="sourcePoint"/><mxPoint x="445" y="972" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="10. Completa la activación" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="453" y="990" width="284" height="19" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="1015" as="sourcePoint"/><mxPoint x="745" y="1015" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="1033" as="sourcePoint"/><mxPoint x="745" y="1057" as="targetPoint"/><Array as="points"><mxPoint x="779" y="1033"/><mxPoint x="779" y="1057"/></Array></mxGeometry></mxCell><mxCell id="c34" value="11. Valida la política de contraseña (se fija ahora, sin contraseña temporal) y la versión del aviso" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="785" y="1028" width="330" height="34" as="geometry"/></mxCell><mxCell id="c35" value="Sin &lt;font face=&quot;monospace&quot;&gt;accepted: true&lt;/font&gt;: &lt;font face=&quot;monospace&quot;&gt;403 CONSENT_REQUIRED&lt;/font&gt; y la cuenta sigue &lt;font face=&quot;monospace&quot;&gt;INVITED&lt;/font&gt;. Versión no vigente: &lt;font face=&quot;monospace&quot;&gt;409 CONSENT_VERSION_OUTDATED&lt;/font&gt;. Correo de otra cuenta: &lt;font face=&quot;monospace&quot;&gt;409 EMAIL_UNAVAILABLE&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="375" y="1089" width="740" height="44" as="geometry"/></mxCell><mxCell id="c36" value="12. En una sola transacción: invitación &lt;font face=&quot;monospace&quot;&gt;USED&lt;/font&gt;, cuenta &lt;font face=&quot;monospace&quot;&gt;INVITED → ACTIVE&lt;/font&gt;, hash de la contraseña, consentimiento en &lt;font face=&quot;monospace&quot;&gt;clinic.patient_consents&lt;/font&gt; (versión, fecha, &lt;font face=&quot;monospace&quot;&gt;ip_hmac&lt;/font&gt;, alcance), &lt;font face=&quot;monospace&quot;&gt;audit_log&lt;/font&gt; &lt;font face=&quot;monospace&quot;&gt;PATIENT_ACTIVATED&lt;/font&gt; y familia de refresh" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="753" y="1151" width="284" height="79" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="1236" as="sourcePoint"/><mxPoint x="1045" y="1236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="13. &lt;font face=&quot;monospace&quot;&gt;publish_all(PatientActivated)&lt;/font&gt; después del commit" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="753" y="1254" width="584" height="19" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="1279" as="sourcePoint"/><mxPoint x="1345" y="1279" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="Recordatorios iniciales y aviso al equipo de atención" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1275" y="1297" width="140" height="59" as="geometry"/></mxCell><mxCell id="c41" value="14. Access token y refresh" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="453" y="1374" width="284" height="19" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="1399" as="sourcePoint"/><mxPoint x="445" y="1399" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="15. &lt;font face=&quot;monospace&quot;&gt;200&lt;/font&gt;: JWT en el cuerpo y cookie de refresh. Un correo nuevo queda sin verificar y recibe un enlace de 24 h" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="153" y="1417" width="284" height="49" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="1472" as="sourcePoint"/><mxPoint x="145" y="1472" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>