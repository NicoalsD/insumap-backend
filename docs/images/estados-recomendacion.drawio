ry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="240"/></Array></mxGeometry></mxCell><mxCell id="c15" value="el médico modifica y aprueba (exige motivo)&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;ModifyRecommendationCommand&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="398" y="194" width="236" height="42" as="geometry"/></mxCell><mxCell id="c16" value="" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="370"/></Array></mxGeometry></mxCell><mxCell id="c17" value="el médico rechaza con motivo&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;RejectRecommendationCommand&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="398" y="324" width="236" height="42" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="500"/></Array></mxGeometry></mxCell><mxCell id="c19" value="nadie atiende antes del vencimiento&lt;br&gt;(trabajo &lt;font face=&quot;monospace&quot;&gt;expire_recommendations&lt;/font&gt;)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="398" y="454" width="236" height="42" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="110"/><mxPoint x="1000" y="163"/></Array></mxGeometry></mxCell><mxCell id="c21" value="" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="240"/><mxPoint x="1000" y="187"/></Array></mxGeometry></mxCell><mxCell id="c22" value="desde APPROVED o APPROVED_WITH_CHANGES al activarse el plan&lt;br&gt;(&lt;font face=&quot;monospace&quot;&gt;ActivateTreatmentPlanCommand&lt;/font&gt;)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1090" y="215" width="330" height="40" as="geometry"/></mxCell><mxCell id="c23" value="" style="html=1;fontFamily=Helvetica;fontSize=12;ellipse;shape=endState;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="1420" y="161" width="28" height="28" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="html=1;fontFamily=Helvetica;fontSize=12;ellipse;shape=endState;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="950" y="356" width="28" height="28" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="html=1;fontFamily=Helvetica;fontSize=12;ellipse;shape=endState;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="950" y="486" width="28" height="28" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="Cada transición queda en &lt;font face=&quot;monospace&quot;&gt;ai.recommendation_decisions&lt;/font&gt; con actor, hora, motivo y valor modificado. &lt;font face=&quot;monospace&quot;&gt;REJECTED&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;APPLIED&lt;/font&gt; y &lt;font face=&quot;monospace&quot;&gt;EXPIRED&lt;/font&gt; son terminales. Aprobar crea una versión nueva del plan en &lt;font face=&quot;monospace&quot;&gt;DRAFT&lt;/font&gt;; hasta &lt;font face=&quot;monospace&quot;&gt;APPLIED&lt;/font&gt; el plan activo no cambia y el paciente no ve nada con dosis." style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1420" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>