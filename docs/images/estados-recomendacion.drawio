<mxfile host="drawio" type="device"><diagram name="estados-recomendacion" id="estados-recomendacion"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="640" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Estados de una recomendación (RecommendationState, P18)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=18;align=left;verticalAlign=middle;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1460" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="302" width="22" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;PROPOSED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;la IA o el respaldo propone&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=13;strokeColor=#6C4FA1;fillColor=#E8E0F4;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;arcSize=30;" vertex="1" parent="1"><mxGeometry x="120" y="280" width="180" height="66" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;APPROVED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;aprobada&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=13;strokeColor=#2E8B57;fillColor=#DFF0E3;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;arcSize=30;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="190" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;APPROVED_WITH_CHANGES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;aprobada con cambios&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=13;strokeColor=#2E8B57;fillColor=#DFF0E3;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;arcSize=30;" vertex="1" parent="1"><mxGeometry x="640" y="210" width="190" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;REJECTED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rechazada&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=13;strokeColor=#B03A2E;fillColor=#F9DEDC;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;arcSize=30;" vertex="1" parent="1"><mxGeometry x="640" y="340" width="190" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;EXPIRED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;vencida&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=13;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;arcSize=30;" vertex="1" parent="1"><mxGeometry x="640" y="470" width="190" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;APPLIED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;aplicada: se activó la versión del plan que la incluye&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=13;strokeColor=#2E8B57;fillColor=#DFF0E3;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1150" y="145" width="210" height=