ce="c4" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="120"/></Array></mxGeometry></mxCell><mxCell id="c11" value="vence el tiempo del nivel sin reconocer&lt;br&gt;(trabajo escalate_unacknowledged_alerts)" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="380"/></Array></mxGeometry></mxCell><mxCell id="c12" value="se reconoce la alerta" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="se resuelve" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="120"/></Array></mxGeometry></mxCell><mxCell id="c14" value="" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="sube de nivel dentro de ESCALATED&lt;br&gt;(atributo de nivel, el estado no cambia)" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="733" y="450"/><mxPoint x="657" y="450"/></Array></mxGeometry></mxCell><mxCell id="c16" value="Cada cambio de estado queda en &lt;font face=&quot;monospace&quot;&gt;alerts.alert_status_history&lt;/font&gt;. Una transición no permitida responde &lt;font face=&quot;monospace&quot;&gt;409 INVALID_STATE_TRANSITION&lt;/font&gt;. Las notificaciones salen por el puente &lt;font face=&quot;monospace&quot;&gt;Notification&lt;/font&gt; (P07)." style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1120" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>