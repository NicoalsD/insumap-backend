"targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="227" as="sourcePoint"/><mxPoint x="310" y="251" as="targetPoint"/><Array as="points"><mxPoint x="344" y="227"/><mxPoint x="344" y="251"/></Array></mxGeometry></mxCell><mxCell id="c15" value="2. &lt;font face=&quot;monospace&quot;&gt;RequestIdMiddleware&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;BodySizeLimitMiddleware&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;CurrentActor&lt;/font&gt; (JWT) y límite de tasa" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="350" y="222" width="330" height="34" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="283" as="sourcePoint"/><mxPoint x="310" y="307" as="targetPoint"/><Array as="points"><mxPoint x="344" y="283"/><mxPoint x="344" y="307"/></Array></mxGeometry></mxCell><mxCell id="c17" value="3. Valida &lt;font face=&quot;monospace&quot;&gt;RecordGlucoseReadingRequest&lt;/font&gt; y la mapea a &lt;font face=&quot;monospace&quot;&gt;RecordGlucoseReadingInput&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="350" y="278" width="330" height="34" as="geometry"/></mxCell><mxCell id="c18" value="4. &lt;font face=&quot;monospace&quot;&gt;execute(input)&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fil