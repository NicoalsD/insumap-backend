mxPoint x="310" y="991" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="14. &lt;font face=&quot;monospace&quot;&gt;201 Created&lt;/font&gt; con &lt;font face=&quot;monospace&quot;&gt;Location&lt;/font&gt; y &lt;font face=&quot;monospace&quot;&gt;GlucoseReadingResponse&lt;/font&gt;&lt;br&gt;(valor en mg/dL, estado y banderas). No espera a los suscriptores" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="128" y="1009" width="174" height="79" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="1094" as="sourcePoint"/><mxPoint x="120" y="1094" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;Después del commit: cada suscriptor abre su propia unidad de trabajo&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1112" width="1680" height="26" as="geometry"/></mxCell><mxCell id="c42" value="15. &lt;font face=&quot;monospace&quot;&gt;GlucoseReadingRecorded&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1268" y="1156" width="174" height="19" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="1181" as="sourcePoint"/><mxPoint x="1450" y="1181" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="16. &lt;font face=&quot;monospace&quot;&gt;EvaluateAlertsOnReadingRecorded&lt;/font&gt;: reglas activas (P08) y ventana reciente (P14)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1078" y="1199" width="364" height="34" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="1239" as="sourcePoint"/><mxPoint x="1070" y="1239" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="17. Si una regla de hipoglucemia coincide: crea la &lt;font face=&quot;monospace&quot;&gt;Alert&lt;/font&gt; en &lt;font face=&quot;monospace&quot;&gt;OPEN&lt;/font&gt; (&lt;font face=&quot;monospace&quot;&gt;HypoglycemiaDetected&lt;/font&gt;)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1078" y="1257" width="364" height="34" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="1297" as="sourcePoint"/><mxPoint x="1070" y="1297" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="1315" as="sourcePoint"/><mxPoint x="1450" y="1339" as="targetPoint"/><Array as="points"><mxPoint x="1484" y="1315"/><mxPoint x="1484" y="1339"/></Array></mxGeometry></mxCell><mxCell id="c49" value="18. &lt;font face=&quot;monospace&quot;&gt;StartAlertEscalationOnAlertOpened&lt;/font&gt;: cadena &lt;font face=&quot;monospace&quot;&gt;AlertEscalationHandler&lt;/font&gt; (P12)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1490" y="1310" width="330" height="34" as="geometry"/></mxCell><mxCell id="c50" value="19. Notifica (P07): correo, Web Push e in-app. Solo &quot;Tienes una alerta nueva en Insumap&quot;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1458" y="1371" width="174" height="64" as="geometry"/></mxCell><mxCell id="c51" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="1441" as="sourcePoint"/><mxPoint x="1640" y="1441" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="1459" as="sourcePoint"/><mxPoint x="1450" y="1483" as="targetPoint"/><Array as="points"><mxPoint x="1484" y="1459"/><mxPoint x="1484" y="1483"/></Array></mxGeometry></mxCell><mxCell id="c53" value="20. Solo con CGM: &lt;font face=&quot;monospace&quot;&gt;RefreshForecastOnReadingRecorded&lt;/font&gt; pide el pronóstico (IA1), como máximo una vez por intervalo" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1490" y="1454" width="360" heig