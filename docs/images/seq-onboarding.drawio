mxPoint x="590" y="136" as="sourcePoint"/><mxPoint x="590" y="1229" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="136" as="sourcePoint"/><mxPoint x="355" y="1229" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="136" as="sourcePoint"/><mxPoint x="120" y="1229" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;Admin de clínica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CLINIC_ADMIN, consola web&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="160" height="76" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;routers&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="275" y="60" width="160" height="76" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Casos de uso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ImportPatientsUseCase, CommandBus&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#2E8B57;fillColor=#DFF0E3;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="510" y="60" width="160" height="76" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;PatientImport&lt;br&gt;Pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;P20 y ClinicIntegrationFactory P03&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#2E8B57;fillColor=#DFF0E3;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="745" y="60" width="160" height="76" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;esquemas clinic e iam&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#6C4FA1;fillColor=#E8E0F4;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="160" height="76" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Notificación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CredentialInvitationNotification P07&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#7A7A7A;fillColor=#FFFFFF;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1215" y="60" width="160" height="76" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Paciente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PWA&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1450" y="60" width="160" height="76" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;1. Importación&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1570" height="26" as="geometry"/></mxCell><mxCell id="c11" value="1. Sube el archivo (&lt;font face=&quot;monospace&quot;&gt;multipart/form-data&lt;/font&gt;): Bundle FHIR R4 o CSV" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="128" y="204" width="219" height="34" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="244" as="sourcePoint"/><mxPoint x="355" y="244" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="2. &lt;font face=&quot;monospace&quot;&gt;ImportPatientsUseCase.execute(input)&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="363" y="262" width="219" height="34" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="302" as="sourcePoint"/><mxPoint x="590" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="3. Elige la pipeline del formato y llama &lt;font face=&quot;monospace&quot;&gt;run()&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="598" y="320" width="219" height="34" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="360" as="sourcePoint"/><mxPoint x="825" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="378" as="sourcePoint"/><mxPoint x="825" y="402" as="targetPoint"/><Array as="points"><mxPoint x="859" y="378"/><mxPoint x="859" y="402"/></Array></mxGeometry></mxCell><mxCell id="c18" value="4. Orden fijo: leer, parsear, validar y mapear con una sola familia de fábrica (&lt;font face=&quot;monospace&quot;&gt;FhirIntegrationFactory&lt;/font&gt; o &lt;font face=&quot;monospace&quot;&gt;CsvIntegrationFactory&lt;/font&gt;; mapper &lt;font face=&quot;monospace&quot;&gt;FhirPatientAdapter&lt;/font&gt;, P06)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="865" y="366" width="430" height="49" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="449" as="sourcePoint"/><mxPoint x="825" y="473" as="targetPoint"/><Array as="points"><mxPoint x="859" y="449"/><mxPoint x="859" y="473"/></Array></mxGeometry></mxCell><mxCell id="c20" value="5. Deduplicar por número de historia (MRN)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="865" y="448" width="330" height="26" as="geometry"/></mxCell><mxCell id="c21" value="6. Filas inválidas o duplicadas quedan en &lt;font face=&quot;monospace&quot;&gt;clinic.import_rows&lt;/font&gt; (no abortan el lote)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="833" y="497" width="219" height="49" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="552" as="sourcePoint"/><mxPoint x="1060" y="552" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="7. Persistir: pacientes en &lt;font face=&quot;monospace&quot;&gt;IMPORTED&lt;/font&gt; y lote cerrado en &lt;font face=&quot;monospace&quot;&gt;clinic.import_batches&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="833" y="570" width="219" height="49" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="625" as="sourcePoint"/><mxPoint x="1060" y="625" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="8. Resultado del lote" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="598" y="643" width="219" height="19" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="668" as="sourcePoint"/><mxPoint x="590" y="668" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="Después del commit se emite &lt;font face=&quot;monospace&quot;&gt;PatientsImported&lt;/font&gt; (evento propuesto, P17)" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="520" y="686" width="610" height="29" as="geometry"/></mxCell><mxCell id="c28" value="9. Resumen: aceptadas, rechazadas y duplicadas" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="128" y="733" width="454" height="19" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="758" as="sourcePoint"/><mxPoint x="120" y="758" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;2. Emisión de credenciales&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="1570" height="26" as="geometry"/></mxCell><mxCell id="c31" value="10. &lt;font face=&quot;monospace&quot;&gt;IssueCredentialsCommand&lt;/font&gt; (P13), decorado por &lt;font face=&quot;monospace&quot;&gt;AuditingCommandHandler&lt;/font&gt; (P09)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="128" y="820" width="454" height="34" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="860" as="sourcePoint"/><mxPoint x="590" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="11. Crea la invitación: código de un solo uso, solo su hash y con vencimiento. Cuenta &lt;font face=&quot;monospace&quot;&gt;IMPORTED → INVITED&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="598" y="878" width="454" height="34" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="918" as="sourcePoint"/><mxPoint x="1060" y="918" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="12. Envía la invitación por correo (o se imprime la hoja)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="598" y="936" width="689" height="19" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="961" as="sourcePoint"/><mxPoint x="1295" y="961" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="13. Correo o impreso con el código de activación" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1303" y="979" width="219" height="34" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1295" y="1019" as="sourcePoint"/><mxPoint x="1530" y="1019" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;3. Activación (detalle en el diagrama de activación)&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1037" width="1570" height="26" as="geometry"/></mxCell><mxCell id="c40" value="14. Código vigente y fecha de nacimiento; luego contraseña y consentimiento" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="363" y="1081" width="1159" height="19" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1530" y="1106" as="sourcePoint"/><mxPoint x="355" y="1106" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="15. Valida el código y activa: invitación &lt;font face=&quot;monospace&quot;&gt;USED&lt;/font&gt;, cuenta &lt;font face=&quot;monospace&quot;&gt;INVITED → ACTIVE&lt;/font&gt; y consentimiento guardado" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="363" y="1124" width="689" height="19" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="1149" as="sourcePoint"/><mxPoint x="1060" y="1149" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="Después del commit se publica &lt;font face=&quot;monospace&quot;&gt;PatientActivated&lt;/font&gt;: recordatorios iniciales y aviso al equipo de atención" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="520" y="1167" width="610" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>