acing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="245" y="60" width="190" height="76" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;RemoteAiService&lt;br&gt;Proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;P11 con CircuitBreaker&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#7A7A7A;fillColor=#FFFFFF;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="60" width="190" height="76" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;AiServiceClient&lt;br&gt;Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;P06&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#7A7A7A;fillColor=#FFFFFF;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="655" y="60" width="190" height="76" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;insumap-ai&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;servicio de IA&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="60" width="190" height="76" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;RuleBasedAiFallback&lt;br&gt;Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;respaldo determinista&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#7A7A7A;fillColor=#FFFFFF;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1065" y="60" width="190" height="76" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;esquemas ai y care&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#6C4FA1;fillColor=#E8E0F4;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1270" y="60" width="190" height="76" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Médico&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;DOCTOR asignado&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1475" y="60" width="190" height="76" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;CommandBus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;handlers P13 con AuditingCommandHandler P09&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#2E8B57;fillColor=#DFF0E3;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1680" y="60" width="190" height="76" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;1. Generar la propuesta&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="160" width="1800" height="26" as="geometry"/></mxCell><mxCell id="c13" value="1. &lt;font face=&quot;monospace&quot;&gt;nightly_triage&lt;/font&gt; o petición explícita" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="143" y="204" width="189" height="34" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="244" as="sourcePoint"/><mxPoint x="340" y="244" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="2. &lt;font face=&quot;monospace&quot;&gt;suggest_titration(...)&lt;/font&gt; (IA4) con &lt;font face=&quot;monospace&quot;&gt;AiSubject&lt;/font&gt;, solo el seudónimo" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="348" y="262" width="189" height="49" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="317" as="sourcePoint"/><mxPoint x="545" y="317" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545" y="335" as="sourcePoint"/><mxPoint x="545" y="359" as="targetPoint"/><Array as="points"><mxPoint x="579" y="335"/><mxPoint x="579" y="359"/></Array></mxGeometry></mxCell><mxCell id="c18" value="3. Consulta el &lt;font face=&quot;monospace&quot;&gt;CircuitBreaker&lt;/font&gt; (&lt;font face=&quot;monospace&quot;&gt;CLOSED&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;OPEN&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;HALF_OPEN&lt;/font&gt;) y &lt;font face=&quot;monospace&quot;&gt;AI_ENABLED&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="585" y="330" width="330" height="34" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Circuito CLOSED o HALF_OPEN y la IA responde&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="391" width="1800" height="26" as="geometry"/></mxCell><mxCell id="c20" value="4. &lt;font face=&quot;monospace&quot;&gt;suggest_titration(...)&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="553" y="435" width="189" height="19" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545" y="460" as="sourcePoint"/><mxPoint x="750" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="5. &lt;font face=&quot;monospace&quot;&gt;POST /v1/titration-suggestions&lt;/font&gt; con &lt;font face=&quot;monospace&quot;&gt;Bearer AI_SERVICE_TOKEN&lt;/font&gt; y &lt;font face=&quot;monospace&quot;&gt;X-Request-Id&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="758" y="478" width="189" height="49" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="533" as="sourcePoint"/><mxPoint x="955" y="533" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="6. &lt;font face=&quot;monospace&quot;&gt;200&lt;/font&gt; con sugerencia, &lt;font face=&quot;monospace&quot;&gt;model_version&lt;/font&gt; y explicación" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="758" y="551" width="189" height="34" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="955" y="591" as="sourcePoint"/><mxPoint x="750" y="591" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="609" as="sourcePoint"/><mxPoint x="750" y="633" as="targetPoint"/><Array as="points"><mxPoint x="784" y="609"/><mxPoint x="784" y="633"/></Array></mxGeometry></mxCell><mxCell id="c27" value="7. Valida la respuesta al convertirla (valores finitos, versión del modelo presente)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="604" width="330" height="34" as="geometry"/></mxCell><mxCell id="c28" value="8. Resultado con &lt;font face=&quot;monospace&quot;&gt;is_fallback = false&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="553" y="665" width="189" height="34" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="705" as="sourcePoint"/><mxPoint x="545" y="705" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;Circuito OPEN, AI_ENABLED = false, timeout, error o respuesta inválida&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="723" width="1800" height="26" as="geometry"/></mxCell><mxCell id="c31" value="9. Delega en el respaldo: IA4 no sugiere nada (&lt;font face=&quot;monospace&quot;&gt;NO_SUGGESTION&lt;/font&gt;) y marca &lt;font face=&quot;monospace&quot;&gt;is_fallback = true&lt;/font&gt; con &lt;font face=&quot;monospace&quot;&gt;fallback_reason&lt;/font&gt; (&lt;font face=&quot;monospace&quot;&gt;AI_TIMEOUT&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;CIRCUIT_OPEN&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;AI_ERROR&lt;/font&gt; o &lt;font face=&quot;monospace&quot;&gt;INSUFFICIENT_DATA&lt;/font&gt;)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="553" y="767" width="599" height="34" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545" y="807" as="sourcePoint"/><mxPoint x="1160" y="807" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;Ambos caminos&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="825" width="1800" height="26" as="geometry"/></mxCell><mxCell id="c34" value="10. Resultado; el caso de uso no sabe si hubo respaldo" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="348" y="869" width="189" height="34" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545" y="909" as="sourcePoint"/><mxPoint x="340" y="909" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="11. Guarda la salida en el esquema &lt;font face=&quot;monospace&quot;&gt;ai&lt;/font&gt;: versión del modelo, explicación, &lt;font face=&quot;monospace&quot;&gt;is_fallback&lt;/font&gt; y &lt;font face=&quot;monospace&quot;&gt;fallback_reason&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="348" y="927" width="1009" height="19" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="952" as="sourcePoint"/><mxPoint x="1365" y="952" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="12. Si la acción no es &lt;font face=&quot;monospace&quot;&gt;NO_SUGGESTION&lt;/font&gt; ni &lt;font face=&quot;monospace&quot;&gt;MAINTAIN&lt;/font&gt;: &lt;font face=&quot;monospace&quot;&gt;Recommendation&lt;/font&gt; en &lt;font face=&quot;monospace&quot;&gt;PROPOSED&lt;/font&gt;, con vencimiento de la clínica y dosis validada contra el protocolo" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="348" y="970" width="1009" height="19" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="995" as="sourcePoint"/><mxPoint x="1365" y="995" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="El paciente nunca ve la recomendación: ve el plan activo, firmado por su médico. La IA nunca da dosis al paciente" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1295" y="1013" width="345" height="59" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;2. Decisión del médico&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="1090" width="1800" height="26" as="geometry"/></mxCell><mxCell id="c42" value="13. &lt;font face=&quot;monospace&quot;&gt;ApproveRecommendationCommand&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;ModifyRecommendationCommand&lt;/font&gt; (con motivo) o &lt;font face=&quot;monospace&quot;&gt;RejectRecommendationCommand&lt;/font&gt; (con motivo)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1578" y="1134" width="189" height="64" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="1204" as="sourcePoint"/><mxPoint x="1775" y="1204" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="14. Guarda la decisión en &lt;font face=&quot;monospace&quot;&gt;ai.recommendation_decisions&lt;/font&gt;: &lt;font face=&quot;monospace&quot;&gt;APPROVED&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;APPROVED_WITH_CHANGES&lt;/font&gt; o &lt;font face=&quot;monospace&quot;&gt;REJECTED&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1373" y="1222" width="394" height="34" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1775" y="1262" as="sourcePoint"/><mxPoint x="1365" y="1262" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="15. Si aprueba o modifica, en la misma transacción: guarda el &lt;font face=&quot;monospace&quot;&gt;TreatmentPlanMemento&lt;/font&gt; (P16), crea una versión &lt;font face=&quot;monospace&quot;&gt;DRAFT&lt;/font&gt; con &lt;font face=&quot;monospace&quot;&gt;copy_for_new_version()&lt;/font&gt; (P05) y aplica el cambio" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1373" y="1280" width="394" height="49" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1775" y="1335" as="sourcePoint"/><mxPoint x="1365" y="1335" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="16. &lt;font face=&quot;monospace&quot;&gt;RecommendationApproved&lt;/font&gt; después del commit: auditoría y aviso de que hay un borrador por activar" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1578" y="1353" width="189" height="64" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1775" y="1423" as="sourcePoint"/><mxPoint x="1570" y="1423" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="17. Revisa el borrador y activa: &lt;font face=&quot;monospace&quot;&gt;ActivateTreatmentPlanCommand&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1578" y="1441" width="189" height="49" as="geometry"/></mxCell><mxCell id="c51" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="1496" as="sourcePoint"/><mxPoint x="1775" y="1496" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="18. La nueva versión pasa a plan activo y la recomendación a &lt;font face=&quot;monospace&quot;&gt;APPLIED&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1373" y="1514" width="394" height="34" as="geometry"/></mxCell><mxCell id="c53" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1775" y="1554" as="sourcePoint"/><mxPoint x="1365" y="1554" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="Si nadie atiende la propuesta antes del vencimiento, el trabajo &lt;font face=&quot;monospace&quot;&gt;expire_recommendations&lt;/font&gt; la pasa a &lt;font face=&quot;monospace&quot;&gt;EXPIRED&lt;/font&gt;. &lt;font face=&quot;monospace&quot;&gt;REJECTED&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;APPLIED&lt;/font&gt; y &lt;font face=&quot;monospace&quot;&gt;EXPIRED&lt;/font&gt; son terminales" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="65" y="1572" width="1780" height="29" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>