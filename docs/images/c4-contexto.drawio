<mxfile host="drawio" type="device"><diagram name="c4-contexto" id="c4-contexto"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="800" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Insumap: contexto del sistema (C4 nivel 1)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=18;align=left;verticalAlign=middle;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1440" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Insumap&lt;/b&gt;&lt;br&gt;[Sistema de software]&lt;br&gt;&lt;br&gt;Plataforma B2B2C de monitoreo de pacientes con diabetes: importación desde la clínica, registro diario, triage, alertas y recomendaciones de IA que el médico decide.&lt;br&gt;&lt;br&gt;&lt;i&gt;Proyecto académico, no es un dispositivo médico&lt;/i&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=13;strokeColor=#0B3C6B;fillColor=#1F6FB2;fontColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="300" height="640" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Paciente (&lt;font face=&quot;monospace&quot;&gt;PATIENT&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Registra glucosa, insulina, comidas, actividad y síntomas; ve su plan activo; recibe alertas y recordatorios; usa el asistente educativo.&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="280" height="120" as="geometry"/></mxCell><mxCell id="c5" value="Usa mediante&lt;br&gt;&lt;b&gt;PWA mobile first&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.125;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;Médico (&lt;font face=&quot;monospace&quot;&gt;DOCTOR&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ve el triage y el detalle de sus pacientes asignados, gestiona el plan y decide las recomendaciones de la IA.&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="280" height="120" as="geometry"/></mxCell><mxCell id="c7" value="Usa mediante&lt;br&gt;&lt;b&gt;Dashboard web&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3594;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Admin de clínica (&lt;font face=&quot;monospace&quot;&gt;CLINIC_ADMIN&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Importa pacientes, emite credenciales, gestiona usuarios y reglas. No ve datos clínicos detallados.&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="280" height="120" as="geometry"/></mxCell><mxCell id="c9" value="Usa mediante&lt;br&gt;&lt;b&gt;Consola web&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5938;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;Admin de plataforma (&lt;font face=&quot;monospace&quot;&gt;PLATFORM_ADMIN&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Crea y gestiona clínicas (tenants). No ve datos de pacientes.&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="280" height="120" as="geometry"/></mxCell><mxCell id="c11" value="Usa mediante&lt;br&gt;&lt;b&gt;Consola web&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8281;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;Sistema de información de la clínica&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Exporta su población como Bundle FHIR R4 o CSV. No hay conexión directa: el admin sube el archivo.&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="90" width="300" height="120" as="geometry"/></mxCell><mxCell id="c13" value="Entrega datos mediante&lt;br&gt;&lt;b&gt;Archivo FHIR R4 o CSV&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.125;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Proveedor del LLM&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Genera texto del resumen previo a la consulta (IA5) y del asistente educativo (IA6). Solo recibe datos seudonimizados.&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="240" width="300" height="120" as="geometry"/></mxCell><mxCell id="c15" value="Envía solicitudes mediante&lt;br&gt;&lt;b&gt;HTTPS, API compatible con OpenAI&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3594;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Correo (SMTP) y servicios Web Push&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Entregan invitaciones, recordatorios y avisos de alerta. Nunca llevan datos clínicos en el cuerpo.&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="390" width="300" height="120" as="geometry"/></mxCell><mxCell id="c17" value="Envía solicitudes mediante&lt;br&gt;&lt;b&gt;SMTP con TLS, Web Push con VAPID&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5938;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Simulador (&lt;font face=&quot;monospace&quot;&gt;insumap-simulator&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Hace de BD de la clínica (exporta FHIR y CSV) y, en modo live, de pacientes que registran lecturas.&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="540" width="300" height="120" as="geometry"/></mxCell><mxCell id="c19" value="Entrega datos mediante&lt;br&gt;&lt;b&gt;Archivo de importación y API con tokens de paciente&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8281;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="24" height="16" as="geometry"/></mxCell><mxCell id="c21" value="Persona" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="756" width="80" height="24" as="geometry"/></mxCell><mxCell id="c22" value="" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#0B3C6B;fillColor=#1F6FB2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="150" y="760" width="24" height="16" as="geometry"/></mxCell><mxCell id="c23" value="Sistema (en alcance)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="180" y="756" width="160" height="24" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="350" y="760" width="24" height="16" as="geometry"/></mxCell><mxCell id="c25" value="Sistema externo" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="380" y="756" width="160" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>