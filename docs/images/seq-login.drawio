<mxfile host="drawio" type="device"><diagram name="seq-login" id="seq-login"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1799" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Secuencia: inicio de sesión, MFA del personal, JWT y refresh" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=18;align=left;verticalAlign=middle;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1460" height="30" as="geometry"/></mxCell><mxCell id="c63" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="130" as="sourcePoint"/><mxPoint x="1290" y="1759" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="130" as="sourcePoint"/><mxPoint x="910" y="1759" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="130" as="sourcePoint"/><mxPoint x="530" y="1759" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="130" as="sourcePoint"/><mxPoint x="150" y="1759" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;PWA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;paciente o personal&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#F2F2F2;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AuthRouter&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#1F6FB2;fillColor=#DAE8F5;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Servicio de autenticación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Argon2PasswordHasher, JwtTokenService, TotpVerifier&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#2E8B57;fillColor=#DFF0E3;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;esquema iam&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#6C4FA1;fillColor=#E8E0F4;fontColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1180" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;1. Contraseña&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="154" width="1300" height="26" as="geometry"/></mxCell><mxCell id="c8" value="1. &lt;font face=&quot;monospace&quot;&gt;POST /api/v1/auth/login&lt;/font&gt; con correo y contraseña" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="198" width="364" height="19" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="223" as="sourcePoint"/><mxPoint x="530" y="223" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="2. Login con el correo normalizado (NFKC, minúsculas) y la IP" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="538" y="241" width="364" height="34" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="281" as="sourcePoint"/><mxPoint x="910" y="281" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="3. Consulta los bloqueos de la pareja (correo, IP) y del correo (contadores por HMAC)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="918" y="299" width="364" height="34" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="339" as="sourcePoint"/><mxPoint x="1290" y="339" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="Bloqueado: &lt;font face=&quot;monospace&quot;&gt;429 RATE_LIMITED&lt;/font&gt; con &lt;font face=&quot;monospace&quot;&gt;Retry-After&lt;/font&gt;, sin verificar la contraseña (igual exista o no el correo)" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="460" y="357" width="900" height="29" as="geometry"/></mxCell><mxCell id="c15" value="4. Busca el usuario por correo" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="918" y="404" width="364" height="19" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="429" as="sourcePoint"/><mxPoint x="1290" y="429" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="447" as="sourcePoint"/><mxPoint x="910" y="471" as="targetPoint"/><Array as="points"><mxPoint x="944" y="447"/><mxPoint x="944" y="471"/></Array></mxGeometry></mxCell><mxCell id="c18" value="5. Verifica Argon2id: si el correo no existe usa &lt;font face=&quot;monospace&quot;&gt;DecoyPasswordHash&lt;/font&gt; (siempre un cálculo, tiempo constante)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="442" width="420" height="34" as="geometry"/></mxCell><mxCell id="c19" value="6. Registra el intento en &lt;font face=&quot;monospace&quot;&gt;iam.login_attempts&lt;/font&gt; (transacción propia, sin la IP en claro)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="918" y="503" width="364" height="34" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="543" as="sourcePoint"/><mxPoint x="1290" y="543" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="Contraseña incorrecta o cuenta &lt;font face=&quot;monospace&quot;&gt;IMPORTED&lt;/font&gt; o &lt;font face=&quot;monospace&quot;&gt;INVITED&lt;/font&gt;: &lt;font face=&quot;monospace&quot;&gt;401 INVALID_CREDENTIALS&lt;/font&gt;, mensaje genérico. Con contraseña correcta pero cuenta &lt;font face=&quot;monospace&quot;&gt;SUSPENDED&lt;/font&gt; o &lt;font face=&quot;monospace&quot;&gt;DEACTIVATED&lt;/font&gt;: &lt;font face=&quot;monospace&quot;&gt;403 ACCOUNT_NOT_ACTIVE&lt;/font&gt;; clínica suspendida: &lt;font face=&quot;monospace&quot;&gt;403 CLINIC_SUSPENDED&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="460" y="561" width="900" height="44" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;2a. Paciente: sesión completa&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="623" width="1300" height="26" as="geometry"/></mxCell><mxCell id="c23" value="7. Crea la familia de refresh: guarda solo el SHA-256 en &lt;font face=&quot;monospace&quot;&gt;iam.refresh_tokens&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="918" y="667" width="364" height="34" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="707" as="sourcePoint"/><mxPoint x="1290" y="707" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="725" as="sourcePoint"/><mxPoint x="910" y="749" as="targetPoint"/><Array as="points"><mxPoint x="944" y="725"/><mxPoint x="944" y="749"/></Array></mxGeometry></mxCell><mxCell id="c26" value="8. &lt;font face=&quot;monospace&quot;&gt;JwtTokenService&lt;/font&gt; firma el JWT de 15 min (HS256, &lt;font face=&quot;monospace&quot;&gt;amr = [&quot;pwd&quot;]&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;tv&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;sid&lt;/font&gt;)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="720" width="420" height="34" as="geometry"/></mxCell><mxCell id="c27" value="9. Access token y refresh opaco" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="538" y="781" width="364" height="19" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="806" as="sourcePoint"/><mxPoint x="530" y="806" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="10. &lt;font face=&quot;monospace&quot;&gt;200 AUTHENTICATED&lt;/font&gt;: JWT en el cuerpo (queda en memoria) y cookie &lt;font face=&quot;monospace&quot;&gt;__Secure-insumap_rt&lt;/font&gt; (HttpOnly, SameSite=Strict)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="824" width="364" height="34" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="864" as="sourcePoint"/><mxPoint x="150" y="864" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;2b. Personal sin MFA enrolado (primer ingreso)&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="882" width="1300" height="26" as="geometry"/></mxCell><mxCell id="c32" value="11. &lt;font face=&quot;monospace&quot;&gt;200 MFA_ENROLLMENT_REQUIRED&lt;/font&gt;: access token de 15 min con &lt;font face=&quot;monospace&quot;&gt;amr = [&quot;pwd&quot;]&lt;/font&gt;, sin refresh" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="926" width="364" height="34" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="966" as="sourcePoint"/><mxPoint x="150" y="966" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="12. &lt;font face=&quot;monospace&quot;&gt;POST /auth/mfa/enrollment&lt;/font&gt; y luego &lt;font face=&quot;monospace&quot;&gt;/enrollment/confirm&lt;/font&gt; con un TOTP" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="984" width="364" height="34" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1024" as="sourcePoint"/><mxPoint x="530" y="1024" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="13. Secreto y URI &lt;font face=&quot;monospace&quot;&gt;otpauth://&lt;/font&gt; una sola vez; al confirmar: códigos de respaldo y sesión completa con &lt;font face=&quot;monospace&quot;&gt;amr = [&quot;pwd&quot;, &quot;otp&quot;]&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="1042" width="364" height="49" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="1097" as="sourcePoint"/><mxPoint x="150" y="1097" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;2c. Personal con MFA&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="1115" width="1300" height="26" as="geometry"/></mxCell><mxCell id="c39" value="14. &lt;font face=&quot;monospace&quot;&gt;200 MFA_CHALLENGE&lt;/font&gt; con &lt;font face=&quot;monospace&quot;&gt;challenge_token&lt;/font&gt; (5 min y 5 intentos, en &lt;font face=&quot;monospace&quot;&gt;iam.auth_challenges&lt;/font&gt;)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="1159" width="364" height="34" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="1199" as="sourcePoint"/><mxPoint x="150" y="1199" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="15. &lt;font face=&quot;monospace&quot;&gt;POST /api/v1/auth/mfa/verify&lt;/font&gt; con &lt;font face=&quot;monospace&quot;&gt;challenge_token&lt;/font&gt; y TOTP o código de respaldo" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="1217" width="364" height="34" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1257" as="sourcePoint"/><mxPoint x="530" y="1257" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="16. &lt;font face=&quot;monospace&quot;&gt;TotpVerifier&lt;/font&gt;: ventana de ±1 paso y &lt;font face=&quot;monospace&quot;&gt;last_used_step&lt;/font&gt; para impedir repeticiones" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="538" y="1275" width="364" height="34" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="1315" as="sourcePoint"/><mxPoint x="910" y="1315" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="TOTP o código incorrecto o repetido: &lt;font face=&quot;monospace&quot;&gt;401 INVALID_CREDENTIALS&lt;/font&gt; y evento &lt;font face=&quot;monospace&quot;&gt;MFA_FAILED&lt;/font&gt;, que cuenta para el bloqueo" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="460" y="1333" width="900" height="29" as="geometry"/></mxCell><mxCell id="c46" value="17. &lt;font face=&quot;monospace&quot;&gt;200 AUTHENTICATED&lt;/font&gt;: JWT con &lt;font face=&quot;monospace&quot;&gt;amr = [&quot;pwd&quot;, &quot;otp&quot;]&lt;/font&gt; y cookie de refresh (vida de 12 h)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="1380" width="364" height="34" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="1420" as="sourcePoint"/><mxPoint x="150" y="1420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="&lt;b&gt;3. Uso del token y renovación&lt;/b&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=12;strokeColor=#888888;fillColor=#E6E6E6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="1438" width="1300" height="26" as="geometry"/></mxCell><mxCell id="c49" value="18. Cada petición: &lt;font face=&quot;monospace&quot;&gt;Authorization: Bearer &lt;jwt&gt;&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="1482" width="364" height="19" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1507" as="sourcePoint"/><mxPoint x="530" y="1507" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="19. En la misma transacción: cuenta activa, &lt;font face=&quot;monospace&quot;&gt;token_version = tv&lt;/font&gt; y clínica activa. Si no: &lt;font face=&quot;monospace&quot;&gt;401 SESSION_REVOKED&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="538" y="1525" width="744" height="19" as="geometry"/></mxCell><mxCell id="c52" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="1550" as="sourcePoint"/><mxPoint x="1290" y="1550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="20. A los 15 min: &lt;font face=&quot;monospace&quot;&gt;POST /api/v1/auth/refresh&lt;/font&gt; (cookie y &lt;font face=&quot;monospace&quot;&gt;X-Requested-With: insumap-web&lt;/font&gt;)" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="1568" width="364" height="34" as="geometry"/></mxCell><mxCell id="c54" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1608" as="sourcePoint"/><mxPoint x="530" y="1608" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="21. Rota el refresh de forma atómica: el anterior pasa a &lt;font face=&quot;monospace&quot;&gt;ROTATED&lt;/font&gt; y se emite uno nuevo en la misma familia" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="538" y="1626" width="744" height="19" as="geometry"/></mxCell><mxCell id="c56" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="1651" as="sourcePoint"/><mxPoint x="1290" y="1651" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="Si llega un refresh ya revocado: se revoca la familia, &lt;font face=&quot;monospace&quot;&gt;tv + 1&lt;/font&gt;, evento &lt;font face=&quot;monospace&quot;&gt;REFRESH_TOKEN_REUSE_DETECTED&lt;/font&gt; y &lt;font face=&quot;monospace&quot;&gt;401 SESSION_REVOKED&lt;/font&gt;" style="html=1;fontFamily=Helvetica;fontSize=12;whiteSpace=wrap;fontSize=11;strokeColor=#C9A227;fillColor=#FFF8DC;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="460" y="1669" width="900" height="29" as="geometry"/></mxCell><mxCell id="c58" value="22. Nuevo access token y nueva cookie de refresh" style="html=1;fontFamily=Helvetica;fontSize=12;text;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;align=center;verticalAlign=middle;fontColor=#222222;fillColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="158" y="1716" width="364" height="19" as="geometry"/></mxCell><mxCell id="c59" value="" style="edgeStyle=none;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="1741" as="sourcePoint"/><mxPoint x="150" y="1741" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>